<Window x:Class="Tasky.Views.TasksHomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tasky.Views"
        xmlns:conv="clr-namespace:Tasky.Common.Converters"
    mc:Ignorable="d"
        Title="TasksHomePage" Height="700" Width="900">

    <Window.Resources>
        <conv:ShowList x:Key="ShowList"/>
        <conv:ShowEditingList x:Key="ShowEditingList"/>
    </Window.Resources>

    <Grid Style="{StaticResource HomePageStyle}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="480"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Path=Presentation}" FontSize="14" Foreground="White" Margin="10,18,0,0"/>

        <ListView Grid.Column="1" Grid.ColumnSpan="2" Width="600" Margin="0,0,100,0" Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource ListPage}" ItemsSource="{Binding Path=TasksToShow}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" BorderThickness="2" BorderBrush="#DDD" Width="565" Height="80">
                        <StackPanel>
                            <StackPanel>
                                <Canvas Visibility="{Binding IsEditingTask,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ShowList}}">
                                    <TextBlock Padding="5,3,0,0" HorizontalAlignment="Left" FontWeight="Bold" Foreground="AntiqueWhite" FontSize="15" Text="{Binding Path=TaskName}" x:Name="nameDisplay"/>
                                    <TextBlock HorizontalAlignment="Left" FontWeight="Bold" FontSize="15" Padding="5,25,0,0" Foreground="AntiqueWhite" Text="{Binding Path=TaskDesc}" x:Name="descDisplay"/>
                                    <CheckBox  Canvas.Left="5" Canvas.Bottom="-62"/>
                                    <Button Width="80" Height="68" Canvas.Right="90" Canvas.Top="5" Click="EditTask" Style="{StaticResource StandardActionBtn}" >
                                        <Button.Content>
                                            <TextBlock Text="Edit" Foreground="White"></TextBlock>
                                        </Button.Content>
                                    </Button>

                                    <Button Width="80" Height="68" Canvas.Right="5" Canvas.Top="5" Click="DeleteTask" Style="{StaticResource StandardActionBtn}">
                                        <Button.Content>
                                            <TextBlock Text="Delete" Foreground="White"></TextBlock>
                                        </Button.Content>
                                    </Button>

                                </Canvas>

                                <Canvas Visibility="{Binding IsEditingTask,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ShowEditingList}}">
                                    <TextBlock Padding="5,6,0,0" FontWeight="Bold" Foreground="AntiqueWhite" FontSize="15" Text="Name:"/>
                                    <TextBox Width="120" Canvas.Left="60" Canvas.Bottom="-25" Text="{Binding Path=TaskName}"/>
                                    <TextBlock Padding="5,29,0,0" FontWeight="Bold" FontSize="15" Foreground="AntiqueWhite"  Text="Descrição:"/>
                                    <TextBox Width="120" Canvas.Left="85" Canvas.Bottom="-50" Text="{Binding Path=TaskDesc}"/>
                                    <Button Content="Salvar" Click="SaveChanges" Canvas.Bottom="-75" Canvas.Left="5" BorderThickness="2" Width="80"/>
                                    <Button Background="Red" Content="Cancelar" Click="EditTask" Canvas.Bottom="-75" Canvas.Left="90" BorderThickness="2" Width="80"/>
                                </Canvas>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>



        <Canvas Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="Black" Height="100">
            <StackPanel Background="Black" Canvas.Left="140">
                <Button Style="{StaticResource StandardActionBtn}" Click="AddTask">
                    <Button.Content>
                        <TextBlock Text="Add Task" Foreground="White"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
