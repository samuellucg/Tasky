<Window x:Class="Tasky.Views.Utils.MessageConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tasky.Views.Utils"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="MessageConfirmation" Height="150" Width="250">
    <Grid Background="#141F4A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        
     
        <TextBlock Text="ATENÇÃO!" Margin="8,6,0,0"
        FontWeight="Bold" FontSize="12" Grid.Row="0" Foreground="White"/>

        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
            x:Name="ConfirmationToUser" FontWeight="Bold" Grid.Row="1" Foreground="White"/>
        <!--Text="Your message here"-->

        <Button Width="70" Height="20" Background="Green" Content="Sim" VerticalAlignment="Bottom" Grid.Row="2" Margin="0,0,85,0" Click="SubmitConfirmation"/>
        <Button Width="70" Height="20" Background="Red" Content="Não" VerticalAlignment="Bottom" Grid.Row="2" Margin="75,0,0,0" Click="UndoConfirmation"/>
    </Grid>
</Window>
